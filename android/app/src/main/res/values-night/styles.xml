<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PurePlayer is light-mode only by design. These deliberately mirror
         values/styles.xml rather than using a dark parent, so a device with the
         OS dark setting on does not flash a black window before Flutter's
         first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/pure_background</item>
    </style>
</resources>
